{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "none"
      ],
      "default": "none",
      "description": "Current Stripe subscription status"
    },
    "subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "subscription_price_id": {
      "type": "string",
      "description": "Stripe price ID of the subscribed plan"
    },
    "subscription_product_id": {
      "type": "string",
      "description": "Stripe product ID of the subscribed plan"
    }
  }
}